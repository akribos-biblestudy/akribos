{
	"name": "akribos",
	"private": true,
	"version": "2.0.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "pnpm@11.3.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:demo": "pnpm db:start && pnpm db:migrate && pnpm db:seed && pnpm dev --host 0.0.0.0",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env scripts/migrate.ts && node --env-file-if-exists=.env build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"test:e2e": "node --env-file-if-exists=.env scripts/prepare-e2e.ts && playwright test",
		"db:start": "docker compose -f compose.dev.yaml up -d",
		"db:stop": "docker compose -f compose.dev.yaml down",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
		"db:backfill-notes": "node --env-file-if-exists=.env scripts/backfill-verse-comments.ts",
		"db:studio": "drizzle-kit studio",
		"db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
		"screenshots:notes": "node --env-file-if-exists=.env scripts/capture-unified-notes-screenshots.ts",
		"data:import": "node --env-file-if-exists=.env scripts/import.ts",
		"test:e2e:only": "playwright test"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1101.0",
		"@aws-sdk/lib-storage": "^3.1101.0",
		"@fontsource/noto-sans": "^5.3.0",
		"@fontsource/noto-sans-hebrew": "^5.3.0",
		"@node-rs/argon2": "^2.0.2",
		"@scalar/api-reference": "^1.64.0",
		"@tiptap/core": "^3.29.2",
		"@tiptap/extension-placeholder": "^3.29.2",
		"@tiptap/pm": "^3.29.2",
		"@tiptap/starter-kit": "^3.29.2",
		"chart.js": "^4.5.1",
		"docx": "^9.7.1",
		"drizzle-orm": "^0.45.2",
		"fflate": "^0.8.3",
		"marked": "^18.0.11",
		"pdfkit": "^0.20.2",
		"pino": "^10.3.1",
		"postgres": "^3.4.9",
		"saxes": "^6.0.0",
		"svelte-dnd-action": "^0.9.79",
		"turndown": "^7.2.4",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/pdfkit": "^0.17.6",
		"@types/turndown": "^5.0.6",
		"@vitest/browser-playwright": "^4.1.8",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	}
}
