# The bundled source bibles are ~37 MB and are only needed when seeding, which is done from a
# checkout or through the admin UI — not from inside the image.
data/*
# Startup backfills existing Hebrew lexicons from this bundled translation.
!data/hebrewstrong.xml
!data/lemmas/
!data/lemmas/**
# Versioned, losslessly decompressed fonts for the offline PDF compiler.
!data/fonts/
data/fonts/*
!data/fonts/pdf/
!data/fonts/pdf/**

