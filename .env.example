# Copy to .env for local development. The values below match compose.dev.yaml.

# --- required ---------------------------------------------------------------
DATABASE_URL="postgres://strongs:strongs@localhost:5432/strongs"

# Signs session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET="dev-only-secret-change-me-0123456789abcdefghijklmno"

# --- optional ---------------------------------------------------------------
# Public origin of the site. adapter-node needs it for CSRF protection in production.
ORIGIN="http://localhost:5173"

# Optional base URL used by `pnpm screenshots:notes` when the dev server runs elsewhere.
# AKRIBOS_PREVIEW_URL="http://localhost:5173"

# Where uploaded resource files are archived so an import can be repeated.
UPLOAD_DIR="./var/uploads"

# Where database dumps are staged before download or upload.
BACKUP_TMP_DIR="./var/backups"

# Encrypts the S3 secret access key stored in the admin backup settings. Generate with:
# openssl rand -base64 48
# Without it, manual backup/restore still work, but the scheduled S3 backup cannot be configured.
# BACKUP_ENCRYPTION_KEY=""

# Transactional email through Brevo. Without a key, mails are logged instead of sent.
# BREVO_API_KEY=""
MAIL_FROM="noreply@akribos.de"
MAIL_FROM_NAME="Akribos"

# The first account registered with this address is granted the admin role.
# BOOTSTRAP_ADMIN_EMAIL="you@example.com"

LOG_LEVEL="info"
